---
import Layout from "@/layouts/BaseLayout.astro";
import meta from "@/html/meta.json";
import raw from "@/html/index.body.html?raw";

// Contact forms post to Web3Forms (free tier). The access key is public by design.
const key = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? "";
const body = raw.replaceAll(
  '<form id="email-form"',
  `<form data-access-key="${key}" id="email-form"`,
);
---

<Layout {...meta["index"]}><Fragment set:html={body} /></Layout>

<script>
  import "@/scripts/contact-form.ts";
  import "@/scripts/faq.ts";
  import "@/scripts/media-popup.ts";
</script>

<style is:global>
  .home_faq-answer {
    height: 0;
    transition: height 0.35s ease;
  }
  .home_faq-icon-wrapper .icon-embed-small {
    transition: transform 0.35s ease;
  }
  .home_faq-accordion.is-open .icon-embed-small {
    transform: rotate(45deg);
  }
  .home_faq-question:focus-visible {
    outline: 2px solid #e6e6e6;
    outline-offset: -2px;
    border-radius: 1.5rem;
  }
  .custom-popup-close:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 4px;
  }
</style>

<noscript>
  <style>
    .home_faq-answer {
      height: auto;
    }
  </style>
</noscript>
